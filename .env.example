# Postgres connection string (Railway sets this automatically when you link the Postgres service)
DATABASE_URL=postgres://user:pass@localhost:5432/leyrd
# Random 32+ byte secret: `openssl rand -base64 32`
AUTH_SECRET=
# Public URL of the app, e.g. https://leyrd.up.railway.app
AUTH_URL=
AUTH_TRUST_HOST=true
# Optional: Google sign-in. Button appears only when both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: AI chat. Without it the app uses tap-based re-planning only.
ANTHROPIC_API_KEY=
